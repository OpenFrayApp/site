---
// The tool-switcher's page. Its job: convince a GM whose tracker forgets the
// relationships that this board remembers them, then hand over — the console, or the
// handbook. Every section pairs one claim with the picture or loop that proves it.
import FeaturePage from '../../components/FeaturePage.astro';
import Split from '../../components/Split.astro';
import Band from '../../components/Band.astro';
import Cards from '../../components/Cards.astro';
import Accordion from '../../components/Accordion.astro';
import { EYEBROW, TEXT_COL } from '../../data/pageStyles.ts';
import consoleRows from '../../assets/screenshots/console-rows.png';
import greatclubLog from '../../assets/screenshots/greatclub-log.png';
import appliedEffects from '../../assets/screenshots/applied-effects.png';
import applyConditions from '../../assets/screenshots/apply-conditions.png';
import applyModifier from '../../assets/screenshots/apply-modifier.png';
import applyCounter from '../../assets/screenshots/apply-counter.png';
import applyName from '../../assets/screenshots/apply-name.png';

const turn = [
  {
    label: 'The turn starts',
    body: 'Save-ends effects keyed to the start roll themselves. Recharge rolls. Durations tick.',
  },
  {
    label: 'The creature acts',
    body: 'Every roll carries the effects that touch it, from either end, automatically.',
  },
  {
    label: 'Damage lands',
    body: 'If the target was concentrating, the check is offered on the spot — DC worked out, both answers one click.',
  },
  {
    label: 'The turn ends',
    body: 'End-of-turn saves roll, timed effects count down, expired ones clear.',
  },
  {
    label: 'The log writes it down',
    body: 'Every change lands in the game log, grouped by round, with the dice behind it.',
  },
];
---

<FeaturePage
  title="Tracking — OpenFray"
  description="OpenFray tracks the state other tools leave in your head: effects with two ends, conditions that expire on the right turn, concentration checks when damage lands, and creature resources that count themselves. Compatible with 5.5e and 5e."
  heading="The board that remembers"
  lede="Your tracker knows the hit points. The fight is decided by everything else — who is concentrating, who has advantage on whom, what ends at the start of whose turn. OpenFray holds all of it, and works it into the rolls."
  video={{
    src: '/media/roll-with-effects.mp4',
    poster: '/media/roll-with-effects.jpg',
    label:
      'The whole board, then close in: the Ogre’s Greatclub swing rolled with two d20s at disadvantage from Prone and the Bane d4 subtracted, both causes named under the roll — then out, and into the log entry that keeps it.',
  }}
  caption="One swing, watched through: the Ogre is Prone and Baned, so its roll takes two d20s, keeps the lower, and loses the d4 — named right under the dice. Then the log files the receipt."
  handbook={[
    { label: 'Effects and conditions', href: '/docs/fight/effects/' },
    { label: 'Concentration', href: '/docs/fight/concentration/' },
    { label: 'Creature resources', href: '/docs/fight/resources/' },
    { label: 'Rests', href: '/docs/fight/rests/' },
    { label: 'The game log', href: '/docs/reference/game-log/' },
  ]}
  current="/features/tracking/"
>
  {
    /* The claim the hero's loop already showed, now told slowly: effects have two
    ends, and the rows carry them. The crop opens into the full board. */
  }
  <section class={`mt-20 ${TEXT_COL}`}>
    <Split
      eyebrow="Two ends"
      heading="Every effect knows whose roll it touches"
      id="tracking-ends-title"
      image={{
        src: consoleRows,
        alt: 'Three tracker rows: the Ogre carrying advantage-against, Prone, and Bane chips between two untouched neighbors.',
      }}
      caption="The badges live on the rows, where the fight is."
    >
      <p class="mt-0 mb-5">
        The cleric drops Bane on the Ogre; the wizard paints it with Faerie Fire. Two badges,
        straight from the spell cards — and each one fires on the right roll, from its own end.
      </p>
      <ul class="m-0 grid list-none gap-3 p-0">
        <li>
          <strong class="font-bold text-text">Outgoing.</strong> Bane rides the Ogre's own attack rolls
          and saving throws, subtracted where it rolls.
        </li>
        <li>
          <strong class="font-bold text-text">Incoming.</strong> Faerie Fire arms everyone who swings
          at it — the Advantage is theirs, and nobody has to be reminded.
        </li>
      </ul>
      <p class="mt-5 mb-0">
        <a
          href="/docs/fight/effects/"
          class="font-semibold text-accent no-underline hover:underline"
        >
          Effects and conditions, in the handbook →
        </a>
      </p>
    </Split>
  </section>

  {
    /* The hero's swing, kept: the log entry is what remains after the moment passes,
    and it is why rulings stop being re-litigated. */
  }
  <section class={`mt-20 ${TEXT_COL}`}>
    <Split
      eyebrow="The receipts"
      heading="The log shows its work"
      id="tracking-receipts-title"
      side="left"
      image={{
        src: greatclubLog,
        alt: 'One log entry: the Ogre’s Greatclub swing at Bram — two d20s at disadvantage, the lower kept, the Bane d4 subtracted, a hit for 15 bludgeoning.',
      }}
    >
      <p class="mt-0 mb-5">
        Every roll is kept with the dice behind it: both d20s and which one counted, the Bane d4
        coming off, the damage dice under the total. When someone asks how the club connected, the
        answer is one entry — 16 kept from two dice, minus the Bane, plus 6, against AC 18.
      </p>
      <p class="mb-0">
        Three hours in, nobody re-litigates a ruling. The log remembers who had what, and when it
        ended.
      </p>
    </Split>
  </section>

  {
    /* The register change: the turn as a machine, with the concentration loop proving
    the one step GMs drop most. */
  }
  <Band
    eyebrow="One turn, held together"
    heading="What runs by itself"
    id="tracking-turn-title"
    align="center"
    class="mt-20"
  >
    <ol class="m-0 grid list-none gap-x-14 gap-y-6 p-0 lg:grid-cols-2">
      {
        turn.map((t, i) => (
          <li class="grid grid-cols-[2.25rem_1fr] gap-4">
            <span class="grid size-9 place-items-center rounded-full border border-accent text-sm font-bold text-accent">
              {i + 1}
            </span>
            <span class="pt-1">
              <span class="block text-base leading-snug font-bold text-text">{t.label}</span>
              <span class="mt-1 block text-sm leading-normal text-muted">{t.body}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </Band>

  {
    /* Durations answer the objection the last section raises: fine, it applies the
    effects — but does it ever take them off? */
  }
  <section class={`mt-20 ${TEXT_COL}`}>
    <Split
      eyebrow="No sticky notes"
      heading="Everything on the board says when it leaves"
      id="tracking-durations-title"
      image={{
        src: appliedEffects,
        alt: 'The applied-effects panel: Bane with 9 rounds left on each of its two riders, Faerie Fire with 8, and Prone until removed, each with its own clear button.',
      }}
      caption="The applied-effects panel, mid-fight: every effect with its time left."
      mediaClass="max-w-[24rem] justify-self-center lg:justify-self-end"
    >
      <p class="mt-0 mb-5">
        Bane has 9 rounds left. Faerie Fire has 8. The Prone stays until someone stands up. Every
        effect on the board carries its own clock, ticks with the turns, and clears itself — no
        sticky note survives three rounds past its spell.
      </p>
      <p class="mb-0">Clearing one early is the button beside it. The board never argues.</p>
    </Split>
  </section>

  {
    /* Centered header: the standalone sections change alignment, so the page stops
    reading as one long left rail. */
  }
  <section class={`mt-20 ${TEXT_COL} text-left`} aria-labelledby="tracking-rest-title">
    <p class={`${EYEBROW} mb-4 text-center`}>The rest of the memory</p>
    <h2
      id="tracking-rest-title"
      class="mx-auto mt-0 mb-8 max-w-[18ch] text-center text-[clamp(1.9rem,4.2vw,3rem)] leading-[1.08] font-extrabold tracking-tight"
    >
      What else it keeps hold of
    </h2>
    <Cards
      accent
      layout="three"
      items={[
        {
          title: 'Resources count down',
          body: "Legendary actions and resistances, recharge abilities, spell slots, limited uses, reactions — all tick as you play, so the mage's last slot is a fact, not a guess.",
        },
        {
          title: 'Reminders, not rulings',
          body: 'OpenFray surfaces what has to be remembered this round and takes a typed result anywhere. The judgment calls stay yours.',
        },
        {
          title: 'Rests restore the right things',
          body: 'A short or long rest restores what the rules say, clears what should end, and keeps what should not.',
        },
      ]}
    />
  </section>

  {
    /* The campaign-scale payoff, walked through the real form: the reader who wants
    this is one step from wanting the account that keeps it. */
  }
  <section class={`mt-20 ${TEXT_COL} text-left`} aria-labelledby="tracking-presets-title">
    <p class={`${EYEBROW} mb-4 text-center`}>Presets</p>
    <h2
      id="tracking-presets-title"
      class="mx-auto mt-0 mb-5 max-w-[18ch] text-center text-[clamp(1.9rem,4.2vw,3rem)] leading-[1.08] font-extrabold tracking-tight"
    >
      Your table's effects, bottled
    </h2>
    <p class="mx-auto mt-0 mb-10 max-w-[44rem] text-center text-lg leading-relaxed text-muted">
      An effect is rarely alone: the spell that frightens also reminds, carries a counter, and dents
      a stat. OpenFray stages the whole package and applies it as one badge — and named, it becomes
      a preset your table reuses for the rest of the campaign. The barbarian's Reckless Attack is
      the classic one to save.
    </p>
    <Accordion
      name="tracking-presets"
      items={[
        {
          id: 'presets-conditions',
          title: 'Pick the conditions',
          body: 'Prone and Frightened, straight off the rules list.',
          image: {
            src: applyConditions,
            alt: 'The condition picker: Prone selected among the full list of conditions.',
          },
        },
        {
          id: 'presets-modifier',
          title: 'Price the damage',
          body: 'A −30 to the hit point maximum, labeled with its cause.',
          image: {
            src: applyModifier,
            alt: 'A modifier in the same form: Undertow, −30 to the hit point maximum.',
          },
        },
        {
          id: 'presets-counter',
          title: 'Keep a secret',
          body: 'The Depth counter is yours; the player view never sees it.',
          image: {
            src: applyCounter,
            alt: 'A counter named Depth with Hidden from players ticked.',
          },
        },
        {
          id: 'presets-name',
          title: 'Name the bundle',
          body: '“Undertow” lands as one badge and clears together.',
          image: {
            src: applyName,
            alt: 'The Apply-as-one field naming the whole package Undertow.',
          },
        },
      ]}
    />
  </section>
</FeaturePage>

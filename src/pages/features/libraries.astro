---
// The content page. Its job: show the GM their books are already in the console —
// and that the shelf is theirs to curate and extend — then hand over to the
// compendium, the console, or the store pages for the importer. Every section
// pairs one claim with the picture or loop made to prove it.
import FeaturePage from '../../components/FeaturePage.astro';
import { Picture } from 'astro:assets';
import Lightbox from '../../components/Lightbox.astro';
import ZoomIcon from '../../components/ZoomIcon.astro';
import Band from '../../components/Band.astro';
import Cards from '../../components/Cards.astro';
import CheckIcon from '../../components/CheckIcon.astro';
import { EYEBROW, TEXT_COL, CARD, DISPLAY_MD } from '../../data/pageStyles.ts';
import { libraries, shippedLibraries } from '../../data/libraries.ts';
import { zoomTrigger, zoomOverlay, zoomBadge } from '../../data/lightbox.ts';
import libraryToggles from '../../assets/screenshots/library-toggles.png';

const libraryShot = {
  img: libraryToggles,
  alt: 'Settings on the Libraries tab: Core, OpenFray, and thirteen third-party collections, with book and edition badges and a Sort by dropdown. Basic Rules 2024, Brood & Bloom, The Waking Garden, Tome of Beasts 1, and Homebrew creations are enabled.',
};

const importerChrome =
  'https://chromewebstore.google.com/detail/openfray-importer/cjooflanhdpfddpppllaelhlfpdinjfk';
const importerFirefox = 'https://addons.mozilla.org/en-US/firefox/addon/openfray-importer/';

const STORE_LINK =
  'inline-flex flex-1 basis-32 items-center justify-center gap-1.5 rounded-lg border ' +
  'border-border bg-bg px-4 py-3 text-base font-semibold text-accent no-underline ' +
  'transition-[border-color,color] hover:border-accent hover:text-text';
---

<FeaturePage
  title="DnD creature and spell libraries — OpenFray"
  description="Search over 2300 creatures and 1900 spells in OpenFray’s free DnD 5e compendium. Choose your libraries, add homebrew, and read stat blocks beside the fight."
  heading="Your DnD creature and spell libraries, beside the fight"
  lede="Over 2300 creatures and 1900 spells included, searchable beside the fight. Choose Basic Rules 2024 or 2014, add the books your table uses, and bring your own homebrew. Compatible with 5.5e and 5e."
  video={{
    src: '/media/compendium.mp4',
    poster: '/media/compendium.jpg',
    label:
      'The compendium opened mid-fight: a search for “moth” returns six creatures from four different libraries, each wearing its book and rules badges, and a click lands the Catafalque Moth’s full stat block.',
  }}
  caption="One search, four shelves: “moth” finds Core, Tome of Beasts, and both of OpenFray's own books — and the stat block is one click away, mid-fight."
  handbook={[
    { label: 'The compendium', href: '/docs/reference/compendium/' },
    { label: 'Build your own creatures and spells', href: '/docs/guides/making-your-own/' },
    { label: 'Set up a campaign and house rules', href: '/docs/guides/campaigns/' },
    { label: 'Import from D&D Beyond', href: '/docs/guides/importer/' },
    { label: 'The stat block', href: '/docs/reference/stat-block/' },
  ]}
  current="/features/libraries/"
>
  <section class={`mt-20 ${TEXT_COL} text-left`} aria-labelledby="lib-toggles-title">
    <p class={`${EYEBROW} mb-4`}>Your call</p>
    <h2 id="lib-toggles-title" class={`mt-0 mb-8 max-w-[18ch] ${DISPLAY_MD}`}>
      Your table picks the shelf
    </h2>
    <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="text-base leading-relaxed text-muted">
        <p class="mt-0 mb-5">
          Find the creatures and spells your table uses without searching through books you leave
          closed. Choose your collections in <strong>Settings → Libraries</strong>, and the
          compendium, <strong>Add creature</strong>, and <strong>Cast spell</strong> lists show what you
          picked.
        </p>
        <p class="mb-5">
          Run Basic Rules 2024, Basic Rules 2014, or both. Bring Tome of Beasts to your next
          encounter, add a spell collection, and keep your homebrew beside them. Book and edition
          badges help you find the version your table uses, right next to the fight.
        </p>
        <p class="mb-0">
          <a href="/console/" class="font-semibold text-accent no-underline hover:underline">
            Open the console and choose your libraries →
          </a>
        </p>
      </div>
      <figure class="m-0">
        <button
          type="button"
          class={`shot-thumb ${zoomTrigger} rounded-xl`}
          data-index="0"
          aria-label="View full library settings screenshot"
        >
          <Picture
            src={libraryShot.img}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            widths={[640, 1080]}
            sizes="(max-width: 1024px) 94vw, 464px"
            alt="Library settings preview: Basic Rules 2024 and OpenFray collections with their selection switches and edition badges."
            loading="lazy"
            class="block h-64 w-full object-cover object-[center_50%] sm:h-80 lg:h-72 lg:object-[center_48%]"
          />
          <span class={zoomOverlay} aria-hidden="true">
            <span class={zoomBadge}><ZoomIcon /></span>
          </span>
        </button>
        <figcaption class="mt-3 text-sm leading-relaxed text-muted">
          Over 2300 creatures and 1900 spells in {shippedLibraries.length + libraries.length} libraries.
        </figcaption>
      </figure>
    </div>
  </section>

  {/* The shelf itself: what ships, and what OpenFray wrote for it. */}
  <Band
    eyebrow="Included"
    heading="What's on the shelf"
    id="lib-included-title"
    align="center"
    class="mt-20"
  >
    <div class="grid items-start gap-8 lg:grid-cols-2">
      <div>
        <h3 class="mt-0 mb-3 text-base leading-relaxed font-bold text-text">
          {shippedLibraries.length} third-party libraries
        </h3>
        <ul class="m-0 grid list-none gap-1.5 p-0 text-sm leading-relaxed text-muted">
          {
            shippedLibraries.map((name) => (
              <li class="flex gap-2">
                <CheckIcon />
                <span>{name}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 mb-0 text-sm leading-relaxed text-muted">
          <a href="/credits/" class="font-semibold text-accent underline">Credits and licenses</a>
        </p>
      </div>
      <div>
        <h3 class="mt-0 mb-3 text-base leading-relaxed font-bold text-text">
          Three books of ours, free
        </h3>
        <ul class="m-0 grid list-none gap-1.5 p-0 text-sm leading-relaxed text-muted">
          {
            libraries.map((l) => (
              <li class="flex gap-2">
                <CheckIcon />
                <a href={l.href} class="font-semibold text-accent">
                  {l.name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 mb-0 text-sm leading-relaxed text-muted">
          Written for OpenFray, published in full on this site, and built into the console. The stat
          blocks are Creative Commons.
        </p>
      </div>
    </div>
  </Band>

  <section class={`mt-20 ${TEXT_COL} text-left`} aria-labelledby="lib-reference-title">
    <h2 id="lib-reference-title" class={`mt-0 mb-8 max-w-[22ch] ${DISPLAY_MD}`}>
      Spell reference beside the fight
    </h2>
    <p class="mt-0 mb-5 text-muted">
      Check a spell’s range, read its effects, and keep running the encounter without leaving the
      console. Same-name spells keep each book’s version, so you can read the one your table uses.
    </p>
    <p class="mb-5 text-muted">
      Supported spells use the console’s casting tools. For reference-only spells, read the card,
      roll the dice, and apply the effects manually.
    </p>
    <p class="mb-0">
      <a
        href="/docs/reference/compendium/"
        class="font-semibold text-accent no-underline hover:underline"
      >
        See how creature and spell lookup works →
      </a>
    </p>
  </section>

  <section class={`mt-20 ${TEXT_COL} text-left`} aria-labelledby="lib-yours-title">
    <p class={`${EYEBROW} mb-4`}>Yours</p>
    <h2 id="lib-yours-title" class={`mt-0 mb-8 max-w-[18ch] ${DISPLAY_MD}`}>
      Everything your table invents
    </h2>
    <Cards
      accent
      items={[
        {
          title: 'Build your own',
          body: 'Build your own creatures and spells in a full editor, then find them beside the published collections when the fight starts.',
        },
      ]}
    >
      <div class={`feature ${CARD} border-l-2 border-l-accent`}>
        <h3 class="m-0 mb-1.5 text-base leading-relaxed font-bold text-text">
          Never retype a stat block
        </h3>
        <p class="m-0 text-sm leading-normal text-muted">
          The free importer turns a D&amp;D&nbsp;Beyond creature page into an OpenFray creature.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <a
            href={importerChrome}
            target="_blank"
            rel="noreferrer"
            class={STORE_LINK}
            title="OpenFray Importer on the Chrome Web Store"
          >
            Chrome →
          </a>
          <a
            href={importerFirefox}
            target="_blank"
            rel="noreferrer"
            class={STORE_LINK}
            title="OpenFray Importer on Firefox Browser Add-ons"
          >
            Firefox →
          </a>
        </div>
      </div>
    </Cards>

    <p class="m-0 mt-10">
      <a href="/compendium/" class="font-semibold text-accent no-underline hover:underline">
        Browse the published libraries →
      </a>
    </p>
  </section>
  <Lightbox shots={[libraryShot]} />
</FeaturePage>

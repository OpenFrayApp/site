---
// The crunchy-moments page. Its job: show the GM the click that resolves the moment
// their evening slows down at — one spell, six saves, every defense applied — then
// hand over to the console or the handbook. Every section pairs one claim with the
// picture or loop made to prove it.
import FeaturePage from '../../components/FeaturePage.astro';
import Split from '../../components/Split.astro';
import Band from '../../components/Band.astro';
import Hero from '../../components/Hero.astro';
import { TEXT_COL, DISPLAY_MD } from '../../data/pageStyles.ts';
import saveRows from '../../assets/screenshots/save-rows.png';
import spellCard from '../../assets/screenshots/spell-card.png';

// The band's four rules: what every roll carries without being asked.
const carries = [
  {
    label: "The attacker's own numbers",
    body: "Click an attack on a creature's stat block and it rolls with that creature's numbers: its attack bonus, its damage dice, the crit applied. Nothing is typed twice.",
  },
  {
    label: 'The effects on the board',
    body: 'Advantage, penalties, and conditions ride into the roll from either end, the way the tracking page tells it. Faerie Fire on a foe arms everyone who swings at it.',
  },
  {
    label: 'Your result, if you prefer it',
    body: 'Every roll can be typed instead. Real dice at the table stay in charge; OpenFray does the arithmetic around whatever you hand it.',
  },
  {
    label: 'Honest dice, written down',
    body: 'A cryptographic generator, every number equally likely, no streak correction ever — and the log keeps each roll with the dice behind it.',
  },
];
---

<FeaturePage
  title="Smart rolling — OpenFray"
  description="Attacks, saves, and damage in OpenFray: rolled from the stat block with every modifier worked in, group saves resolved in one click, and honest dice with a full roll log. Compatible with 5.5e and 5e."
  heading="Every roll, already worked out"
  lede="One spell hits six creatures. OpenFray rolls all six saves, applies each one's defenses, and hands you the damage — one click, done. That moment is why this page exists."
  video={{
    src: '/media/six-saves.mp4',
    poster: '/media/six-saves.jpg',
    label:
      'A Fireball cast at six targets in the console: the saves roll at once, immunity zeroes one line, resistance halves another, and the player rows wait for their own dice.',
  }}
  caption="One Fireball, watched through: six targets picked, every save rolled at once, every defense applied per row — and nothing lands until you say so."
  handbook={[
    { label: 'Attacks and damage', href: '/docs/guides/attacks/' },
    { label: 'Saving throws', href: '/docs/guides/saves/' },
    { label: 'Spells', href: '/docs/guides/spells/' },
    { label: 'Dice and roll formulas', href: '/docs/reference/dice/' },
    { label: 'The game log', href: '/docs/reference/game-log/' },
  ]}
  current="/features/rolling/"
>
  {
    /* The hero's held frame, told slowly: six rows, five different outcomes, and the
    reasons printed beside each one. */
  }
  <Band class="mt-20">
    <Hero
      eyebrow="Group saves"
      heading="Six rows, every defense applied"
      level="h2"
      side="right"
      bleed
      headingClass={`max-w-[18ch] ${DISPLAY_MD}`}
      tagline="Every row prints its reasons. The Goblin Warrior rolled a 2, so all 32 waits in its box. The Hell Hound saved — and immunity zeroes it anyway. The Quasit's Magic Resistance rolled two d20s and kept the 19, and resistance cuts its half again, down to 8. The made saves take 16."
      image={{
        src: saveRows,
        alt: 'The rolled dice and six outcome rows: the Goblin Warrior failing on a 2 and owing all 32 fire, the fire-immune Hell Hound zeroed despite saving, the Quasit with both Magic Resistance d20s on its row and its damage cut to 8, and the two player rows answered Save.',
      }}
      caption="The eight d6 are listed right above the rows they hit."
    >
      <p class="mt-5 mb-0 text-base leading-relaxed text-muted">
        Your players roll their own saves at the table. Their rows take a Save and a Fail button
        instead of dice — Kessa and Bram called theirs, and the 16 followed the click.
      </p>
    </Hero>
  </Band>

  {
    /* Casting is where the rolls come from: the card holds the rules text and the
    uses, so the book stays on the shelf. */
  }
  <section class={`mt-20 ${TEXT_COL}`}>
    <Split
      eyebrow="Casting"
      heading="The whole spell, one card"
      id="rolling-cast-title"
      side="left"
      image={{
        src: spellCard,
        alt: 'The Fireball card opened from a stat block: 2 uses left, casting time, range, components, the full rules text, and a Cast button.',
      }}
      mediaClass="max-w-[26rem] justify-self-center lg:justify-self-start"
    >
      <p class="mt-0 mb-5">
        Casting from a stat block opens the full card: range, components, duration, and the rules
        text, with the creature's remaining uses counted beside it. Cast, and the save rolls for
        every target at once — the group save above is this card, one click later.
      </p>
      <p class="mb-0">
        <a
          href="/docs/guides/spells/"
          class="font-semibold text-accent no-underline hover:underline"
        >
          Spells, in the handbook →
        </a>
      </p>
    </Split>
  </section>

  <Band
    eyebrow="The rules, respected"
    heading="What a roll takes with it"
    id="rolling-carries-title"
    align="center"
    class="mt-20"
  >
    <ol class="m-0 grid list-none gap-x-14 gap-y-6 p-0 lg:grid-cols-2">
      {
        carries.map((c, i) => (
          <li class="grid grid-cols-[2.25rem_1fr] gap-4">
            <span class="grid size-9 place-items-center rounded-full border border-accent text-sm font-bold text-accent">
              {i + 1}
            </span>
            <span class="pt-1">
              <span class="block text-base leading-snug font-bold text-text">{c.label}</span>
              <span class="mt-1 block text-sm leading-normal text-muted">{c.body}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </Band>
</FeaturePage>

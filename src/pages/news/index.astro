---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE, WEBSITE_ID, PUBLISHER_ID, breadcrumbs } from '../../data/seo.ts';
import {
  KIND_LABEL,
  NEWS_BASE,
  byNewest,
  formatDate,
  isoDate,
  postMeta,
  postPath,
  postUrl,
  readingTimeLabel,
} from '../../data/news.ts';

const posts = byNewest(await getCollection('news'));

const title = 'News — OpenFray updates and short DnD 5e adventures';
const description =
  'What has changed in the OpenFray combat console, and short Dungeons and Dragons 5e ' +
  'adventures to run with it — free to read, with the creatures already in the app.';

const schema = [
  {
    '@type': 'Blog',
    '@id': `${SITE}${NEWS_BASE}/#blog`,
    name: 'OpenFray news',
    description,
    url: `${SITE}${NEWS_BASE}/`,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': PUBLISHER_ID },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `${postUrl(post.id)}#post`,
      headline: post.data.title,
      description: post.data.description,
      url: postUrl(post.id),
      datePublished: isoDate(post.data.date),
      author: { '@id': PUBLISHER_ID },
    })),
  },
  breadcrumbs([
    { name: 'OpenFray', url: '/' },
    { name: 'News', url: `${NEWS_BASE}/` },
  ]),
];

// The rail's two stacked lines. Uppercase and tracked so the date and the kind read as
// one label block against the title beside them.
const RAIL = 'text-xs leading-relaxed font-semibold tracking-[0.14em] text-muted uppercase';
---

<Layout
  title={title}
  description={description}
  keywords={['OpenFray news', 'DnD 5e adventures', 'Dungeons and Dragons 5e one shot']}
  schema={schema}
>
  <main class="mx-auto w-full max-w-5xl px-6 pt-4 pb-16 max-[560px]:px-4">
    <header class="mb-12 max-w-[42rem]">
      <h1
        class="mt-0 mb-4 text-[clamp(2.1rem,4.6vw,3rem)] leading-[1.06] font-extrabold tracking-tight text-text"
      >
        News
      </h1>

      <p class="m-0 mb-4 text-[1.3rem] leading-[1.55] text-text">
        What has changed in the console, and short adventures to run with it.
      </p>

      <p class="m-0 text-base leading-relaxed text-muted">
        Adventures use creatures from <a class="text-accent" href="/compendium/"
          >OpenFray’s own libraries</a
        >, so everything a fight needs is already in <a class="text-accent" href="/console/"
          >the console</a
        >. There is <a class="text-accent" href={`${NEWS_BASE}/rss.xml`}>a feed</a> if you would rather
        not check back.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-base leading-relaxed text-muted">
          Nothing here yet. The first post lands with the next release.
        </p>
      ) : (
        <ul class="m-0 list-none border-t border-border p-0">
          {posts.map((post) => {
            const meta = postMeta(post.data);
            return (
              <li class="m-0 border-b border-border">
                {/* The whole row is one link, so the target is the entry rather than the
                    title alone — easier to hit, and one stop in the tab order. */}
                <a
                  class="group grid grid-cols-[8.5rem_minmax(0,1fr)] items-start gap-x-8 py-8 no-underline max-[640px]:grid-cols-[minmax(0,1fr)] max-[640px]:gap-y-3 max-[640px]:py-6"
                  href={postPath(post.id)}
                >
                  <span
                    class={`flex flex-col gap-1 ${RAIL} max-[640px]:flex-row max-[640px]:gap-3`}
                  >
                    <time class="tracking-normal normal-case" datetime={isoDate(post.data.date)}>
                      {formatDate(post.data.date)}
                    </time>
                    <span>{KIND_LABEL[post.data.kind]}</span>
                  </span>

                  <span class="min-w-0">
                    <strong class="block text-[1.2rem] leading-snug font-bold text-text transition-[color] group-hover:text-accent">
                      {post.data.title}
                    </strong>

                    <span class="mt-2 block text-base leading-relaxed text-muted">
                      {post.data.description}
                    </span>

                    <span class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.85rem] leading-relaxed text-muted">
                      <span>{readingTimeLabel(post.body ?? '')}</span>
                      {meta && (
                        <>
                          <span class="text-border" aria-hidden="true">
                            /
                          </span>
                          <span>{meta}</span>
                        </>
                      )}
                    </span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </main>
</Layout>

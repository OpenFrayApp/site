---
import { getCollection, render } from 'astro:content';
import BookLayout from '../../layouts/BookLayout.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('waking-garden');
  return chapters.map((chapter) => ({ params: { slug: chapter.id }, props: { chapter } }));
}

const { chapter } = Astro.props;
const { Content, headings } = await render(chapter);

const keywords = [
  'The Waking Garden',
  'OpenFray bestiary',
  'DnD 5e plant monsters',
  'Dungeons and Dragons 5e homebrew creatures',
  chapter.data.title,
];
---

<BookLayout
  title={`${chapter.data.title} — The Waking Garden | OpenFray`}
  description={chapter.data.description}
  current={chapter.id}
  eyebrow={chapter.data.eyebrow}
  heading={chapter.data.title}
  headings={headings}
  keywords={keywords}
>
  <Content />
</BookLayout>

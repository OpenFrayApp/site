---
// The print edition, LOCAL ONLY — assemble-site.mjs drops this route from dist/ and the
// sitemap filter hides it. Run `npm run dev -w site`, open /the-waking-garden/print/,
// print to PDF. Pagination takes about a minute and the page is blank while it runs.
//
// It is a page rather than a generator so the book renders through the site's own
// components and stylesheet; the Typst edition it replaced spent most of its effort
// restating that CSS in another language.
import { getCollection, render } from 'astro:content';
import { creatures, formatCr } from '../../data/wakingGarden.ts';
import '../../styles/global.css';
import '../../styles/waking-garden.css';

const chapters = (await getCollection('waking-garden')).sort((a, b) => a.data.order - b.data.order);
const parts = await Promise.all(
  chapters.map(async (c) => ({ ...c, Content: (await render(c)).Content })),
);

const crs = creatures.map((c) => c.cr ?? 0);
const range = `${formatCr(Math.min(...crs))}–${formatCr(Math.max(...crs))}`;
---

<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>The Waking Garden — print edition</title>
  </head>
  <body class="print-book">
    <section class="cover">
      <p class="cover-kicker">OpenFray · Compendium</p>
      <h1 class="cover-title">The Waking<br />Garden</h1>
      <p class="cover-subtitle">A bestiary of cultivated horrors, compatible with 5e and 5.5e.</p>
      <hr class="cover-rule" />
      <p class="cover-lede">
        Sixty-seven creatures for a world where the things people grow have started growing back.
        Twelve species of sentient vegetable across three stages of life, the ecology that lives
        alongside them, the fey who tend them, and the thing they are all cuttings from.
      </p>
      <p class="cover-meta">
        <strong>{creatures.length} creatures</strong> · CR {range} · 19 ready-to-run fights<br />
        Built for OpenFray, a free combat console for Game Masters — openfray.app
      </p>
    </section>

    {
      parts.map((part) => (
        <section class="chapter">
          <header class="chapter-head">
            {part.data.eyebrow && <p class="chapter-eyebrow">{part.data.eyebrow}</p>}
            <h1 class="chapter-title">{part.data.title}</h1>
          </header>
          <div class="book-body chapter-body">
            <part.Content />
          </div>
        </section>
      ))
    }

    <script>
      import {
        bindHeadingsToNext,
        flattenStatBlockFolds,
        groupStatBlockHeads,
        insertPageRefPlaceholders,
        normalizeColumnTops,
        replaceLibraryTerms,
        resolvePageRefs,
      } from '../../lib/print.ts';

      // The count is asserted so a copy edit that changes the web's "library" wording
      // reports rather than silently rewriting a sentence.
      const EXPECTED_LIBRARY_TERMS = 5;
      const hits = replaceLibraryTerms(document.body);
      if (hits !== EXPECTED_LIBRARY_TERMS) {
        console.warn(
          `Print: replaced ${hits} "library" terms, expected ${EXPECTED_LIBRARY_TERMS}. ` +
            'Check the result, then update EXPECTED_LIBRARY_TERMS in print.astro.',
        );
      }

      flattenStatBlockFolds(document);
      groupStatBlockHeads(document);
      bindHeadingsToNext(document);
      const refCount = insertPageRefPlaceholders(document);

      try {
        // Only print-paged.css is handed over. Given no stylesheets Paged.js strips and
        // parses every one with css-tree, which cannot read Tailwind v4's
        // `@media (width >= 40rem)` and throws on the raw prelude — leaving a blank page.
        // Its polyfill build also sits behind an export condition Vite will not resolve,
        // hence driving Previewer directly.
        const [{ Previewer }, { default: pagedCss }] = await Promise.all([
          import('pagedjs'),
          import('../../styles/print-paged.css?raw'),
          // Chunking measures text, so it has to wait for the serif. Without this the
          // book paginates against the fallback face and the result varies run to run —
          // 65 or 66 pages, and the odd cross-reference resolving against a stale page.
          document.fonts.ready,
        ]);
        const flow = await new Previewer().preview(undefined, [{ 'print-paged.css': pagedCss }]);

        // Drop the top margin off whatever opens a page or a column. Paged.js keeps it on
        // the first column but collapses it in a continuation, so the two columns start
        // at different heights. It cannot be a `:first-child` rule — Paged.js rebuilds
        // the ancestor chain per page, so depth and sibling order vary — but the geometry
        // is reliable: nothing above an element means its gap is exactly its own margin.
        for (const content of document.querySelectorAll('.pagedjs_page_content')) {
          const box = content.getBoundingClientRect();
          const middle = box.left + box.width / 2;
          const columns = { left: [], right: [] };

          for (const block of content.querySelectorAll('h1, h2, h3, h4, p, ul, ol, dl, table')) {
            const rect = block.getBoundingClientRect();
            // A spanning element is not in either column and starts its own flow.
            if (!rect.height || rect.width > box.width * 0.8) continue;
            const margin = parseFloat(getComputedStyle(block).marginTop) || 0;
            columns[rect.left < middle ? 'left' : 'right'].push({
              block,
              margin,
              // Margin-box top: equal for everything that starts a column.
              edge: rect.top - margin,
            });
          }

          for (const items of Object.values(columns)) {
            if (!items.length) continue;
            const start = Math.min(...items.map((i) => i.edge));
            for (const item of items) {
              if (item.margin && item.edge - start <= 1) item.block.style.marginTop = '0';
            }
          }
        }

        // Resolve against the rendered pages: Paged.js lays out clones and keeps the
        // source in a <template>, so every creature id exists twice.
        const area = document.querySelector('.pagedjs_pages');
        const pageOf = new Map();
        area.querySelectorAll('.pagedjs_page').forEach((page, i) => pageOf.set(page, i + 1));

        let resolved = 0;
        for (const ref of area.querySelectorAll('.pageref')) {
          const href = ref.previousElementSibling?.getAttribute('href');
          const slug = href?.slice(href.indexOf('#') + 1);
          const target = slug && area.querySelector(`[id="${CSS.escape(slug)}"]`);
          const page = target && pageOf.get(target.closest('.pagedjs_page'));
          if (page) {
            ref.textContent = ` (p. ${page})`;
            resolved += 1;
          } else {
            ref.remove();
          }
        }
        if (resolved < refCount) {
          console.warn(`Print: ${refCount - resolved} creature reference(s) found no target.`);
        }

        console.info(`Paged.js: ${flow.total} pages, ${resolved}/${refCount} refs resolved.`);
        document.body.dataset.pages = String(flow.total);
      } catch (error) {
        // preview() empties the body before chunking, so a failure otherwise leaves a
        // blank page and no clue why.
        console.error('Paged.js failed to paginate:', error);
        document.body.dataset.pages = 'failed';
      }
    </script>
  </body>
</html>

---
// The site's front door, and its one job: get a Game Master to open the console.
// The hero speaks to the paper-and-pencil GM and never sounds like software; the
// deeper sections speak to the tool-switcher; the free account is seeded after the
// value is proven and never gates it. Every section pairs its claim with the proof
// made for it — the same staged fight throughout — and keeps a click to the
// console, the handbook, or a feature page within reach.
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import Lightbox from '../components/Lightbox.astro';
import ZoomIcon from '../components/ZoomIcon.astro';
import CheckIcon from '../components/CheckIcon.astro';
import Split from '../components/Split.astro';
import Cards from '../components/Cards.astro';
import Band from '../components/Band.astro';
import Hero from '../components/Hero.astro';
import Panel from '../components/Panel.astro';
import { zoomTrigger, zoomOverlay, zoomBadge } from '../data/lightbox.ts';
import { hero, tagline } from '../data/hero.ts';
import { libraries, shippedLibraries } from '../data/libraries.ts';
import { EYEBROW, TEXT_COL, CARD, DISPLAY_MD, SHOT_FRAME } from '../data/pageStyles.ts';
import { Picture } from 'astro:assets';
import compendiumHero from '../assets/screenshots/compendium-hero.png';
import consoleHero from '../assets/screenshots/console-hero.png';
import groupSaveHero from '../assets/screenshots/group-save-hero.png';
import playerViewHero from '../assets/screenshots/player-view-hero.png';
import saveRows from '../assets/screenshots/save-rows.png';

const importerChrome =
  'https://chromewebstore.google.com/detail/openfray-importer/cjooflanhdpfddpppllaelhlfpdinjfk';
const importerFirefox = 'https://addons.mozilla.org/en-US/firefox/addon/openfray-importer/';

const repo = 'https://github.com/OpenFrayApp';
// The closing panel's links. Credits is the compliance record for every source we use,
// which is where a license question actually gets answered.
const wrapUpLinks = [
  { label: 'OpenFray on GitHub', href: repo },
  { label: 'Report a bug', href: `${repo}/issues` },
  { label: 'Credits and licenses', href: `${repo}/blob/main/CREDITS.md` },
  { label: 'Read the handbook', href: '/docs/' },
];

// The lightbox holds the full screenshots. The console shot opens itself larger; the
// two cropped proofs below it open into the full boards they were cut from — the one
// question a crop raises that a click should answer.
const consoleShot = {
  img: consoleHero,
  alt: 'The whole console mid-fight: the tracker with the Ogre carrying advantage-against, Prone, and Bane chips, its stat block in the middle, and the game log ending on its Greatclub swing — two d20s at disadvantage, the Bane d4 subtracted, a hit for 15.',
};
const groupShot = {
  img: groupSaveHero,
  alt: 'A Fireball rolled against six creatures at once, each row showing its save and the damage waiting to be applied — the failed Ogre owing all 32, the fire-immune Hell Hound at 0, the resistant Quasit at 16.',
};
const compendiumShot = {
  img: compendiumHero,
  alt: 'The compendium open on the Creatures tab: a searchable list of 859 creatures from four libraries, each badged with its book and rules version, and the Aboleth stat block in the reading pane.',
};
const zoomable = [groupShot, compendiumShot];

// What the reader is looking at, named: the console's three panes, in the words the
// feature pages keep using.
const legend = [
  {
    n: 1,
    label: 'The tracker',
    body: 'Turn order, hit points, and every condition as a chip on its row.',
  },
  {
    n: 2,
    label: 'The stat block',
    body: 'The active creature, its actions one click from rolled.',
  },
  {
    n: 3,
    label: 'The game log',
    body: 'Every change written down, with the dice behind it.',
  },
];

// Your first fight, in the real buttons' own words.
const firstFight = [
  {
    label: 'Add your party',
    body: 'The Add PC popover takes a name, an armor class, and hit points. Quick add covers whatever wanders in.',
  },
  {
    label: 'Pick the foes',
    body: 'Search over 2000 creatures across the libraries your table enabled, or bring your own homebrew.',
  },
  {
    label: 'Begin',
    body: "Type your players' initiative rolls, the monsters roll their own, and Start combat orders the board.",
  },
];

// The table stakes. Two of these need an account and say so: the hero promises no
// account needed, so a card that quietly requires one would contradict it.
const rest = [
  {
    title: 'Honest dice, written down',
    body: 'Every number equally likely, and every roll logged with the dice behind it.',
  },
  {
    title: 'End-of-combat recap',
    body: 'Experience earned, how long the fight ran, and the hits your table will retell.',
  },
  {
    title: 'Campaigns with house rules',
    body: "Your table's rulings set once and applied to every fight. Needs a free account.",
  },
  {
    title: 'A durable roster',
    body: 'Save your players once and drop them into any fight — with a free account — plus a quick add for whatever wanders in.',
  },
  {
    title: 'Nothing waits on the network',
    body: 'The fight lives in the browser and saves in the background. Rolling a die answers instantly.',
  },
  {
    title: 'Sync when you want it',
    body: 'Sign in free with Discord or Google to pick a fight up on another device.',
  },
];
---

<Layout
  title="OpenFray — a DnD 5e combat console for GMs"
  description="OpenFray is a free, open-source combat console for running encounters in the world's oldest tabletop roleplaying game. Compatible with 5.5e and 5e: initiative, creature resources, conditions, group saves, and honest dice."
>
  <main class={`${hero} overflow-x-clip`}>
    <section class={`hero-lede ${TEXT_COL} text-left`}>
      <p class={`${EYEBROW} mb-5`}>Free · Open source · No account</p>

      <h1
        class="mt-0 mb-5 max-w-[20ch] text-[clamp(2.5rem,6.5vw,4.25rem)] leading-[1.04] font-extrabold tracking-tight"
      >
        Never lose concentration.
      </h1>

      <p class={`${tagline} mb-8`}>
        OpenFray holds the whole state of a Dungeons and Dragons encounter — who’s frightened by
        whom, who has advantage on whom, what every creature has left to spend — so you run it
        instead of remembering it.
      </p>

      <div class="cta-row flex flex-wrap gap-3">
        <Cta href="/console/">Open the console →</Cta>
        <Cta href="#screenshots" variant="ghost">See it running</Cta>
      </div>

      <ul
        class="facts m-0 mt-7 flex list-none flex-wrap gap-x-8 gap-y-1.5 p-0 text-sm leading-relaxed text-muted"
      >
        <li>Nothing to install</li>
        <li>No account needed</li>
        <li>Compatible with 5.5e and 5e</li>
      </ul>
    </section>

    {
      /* The payoff for "See it running": one honest picture of a fight already under
      way, at the one width on the whole site where the full console is legible. The
      numbered legend teaches the three panes in the words the feature pages reuse. */
    }
    <section
      class={`console-shot mt-20 ${TEXT_COL} text-left`}
      id="screenshots"
      aria-labelledby="console-shot-title"
    >
      <p class={`${EYEBROW} mb-4`}>A fight in progress</p>
      <h2 id="console-shot-title" class={`mt-0 mb-8 max-w-[18ch] ${DISPLAY_MD}`}>
        The whole encounter on one screen
      </h2>

      <figure class="m-0">
        <Picture
          src={consoleShot.img}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[1024, 1600, 2048]}
          sizes="(max-width: 1024px) 94vw, 61rem"
          alt={consoleShot.alt}
          loading="lazy"
          class="block h-auto w-full rounded-2xl border border-border"
        />
      </figure>

      <ol class="m-0 mt-6 grid list-none gap-x-8 gap-y-4 p-0 sm:grid-cols-3">
        {
          legend.map((l) => (
            <li class="grid grid-cols-[1.75rem_1fr] gap-3">
              <span class="grid size-7 place-items-center rounded-full border border-accent text-xs font-bold text-accent">
                {l.n}
              </span>
              <span>
                <span class="block text-sm leading-snug font-bold text-text">{l.label}</span>
                <span class="mt-0.5 block text-sm leading-normal text-muted">{l.body}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    {
      /* The differentiator, moving: the one loop this page carries. Everything else
      stays a still — the front door should load like one. */
    }
    <section class={`mt-20 ${TEXT_COL}`}>
      <Split
        eyebrow="The difference"
        heading="What OpenFray keeps hold of"
        id="difference-title"
        caption="One swing, watched through: Prone forces two d20s and the lower die, Bane takes its d4 — named right under the roll — and the log files the receipt."
      >
        <p class="mt-0 mb-5">
          Effects have two ends, and OpenFray records which end is which. The cleric's Bane rides
          the Ogre's own rolls; the wizard's Faerie Fire arms everyone who swings at it — and when
          the Ogre finally attacks, all of it is already in the arithmetic.
        </p>
        <p class="mb-5">
          A scratchpad, not a second character sheet: it never asks for a player's build. It tracks
          what just happened and what has to be remembered this round — which is why it stays fast
          instead of becoming a worse VTT.
        </p>
        <p class="mb-0">
          <a
            href="/features/tracking/"
            class="font-semibold text-accent no-underline hover:underline"
          >
            How the tracking works →
          </a>
        </p>
        <video
          slot="media"
          class={`motion-loop ${SHOT_FRAME}`}
          src="/media/roll-with-effects.mp4"
          poster="/media/roll-with-effects.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="The Ogre's Greatclub swing rolled in the console: the camera closes in as two d20s roll at disadvantage from Prone, the Bane d4 is subtracted with both causes named under the roll, and the log keeps the receipt."
        ></video>
      </Split>
    </section>

    {
      /* The crunchy moment, full width: the page's most quoted line as a heading,
      its proof bleeding off the left edge, and the click into the full board. */
    }
    <Band class="mt-20">
      <Hero
        eyebrow="The crunchy moments"
        heading="Six creatures, one Fireball, one click"
        level="h2"
        side="left"
        bleed
        overhang="2.5rem"
        headingClass={`max-w-[16ch] ${DISPLAY_MD}`}
        tagline="One spell hits six creatures, and OpenFray rolls every save at once with each one's defenses applied — the failed Ogre owes all 32, the fire-immune Hell Hound reads 0, the resistant Quasit takes 16. Cast straight from the stat block, and the whole spell card comes with it."
        image={{
          src: saveRows,
          alt: 'The rolled dice and six outcome rows of a group save: the failed Ogre owing all 32 fire, the fire-immune Hell Hound zeroed, the resistant Quasit halved to 16, and two player rows with Save and Fail buttons.',
        }}
        zoomIndex={0}
        caption="Every save rolled at once — and the eight d6 listed right above the rows they hit. Click through for the whole board."
      >
        <p class="mt-6 mb-0">
          <a
            href="/features/rolling/"
            class="font-semibold text-accent no-underline hover:underline"
          >
            More about smart rolling →
          </a>
        </p>
      </Hero>
    </Band>

    {
      /* The same fight again, from the table's side of the screen: the claims
      stacked beside the whole screen they describe. */
    }
    <section class={`player-view mt-20 ${TEXT_COL}`}>
      <Split
        eyebrow="For your players"
        heading="Share the fight, keep your secrets"
        id="player-view-title"
        side="left"
        image={{
          src: playerViewHero,
          alt: 'The shared player view of the same fight: the party listed with exact hit points, the foes in words with their effect chips, the game log beside them, and a footer noting that nothing is saved.',
        }}
        caption="The same fight as above, the way your table sees it."
      >
        <Cards
          layout="stack"
          items={[
            {
              title: 'A live view on their own devices',
              body: "Share a link and the turn order, conditions, and game log follow the fight on your players' screens as you run it. It's read-only — there is nothing there to press.",
            },
            {
              title: 'You choose what they see',
              body: 'Hit points in words — Bloodied, not a number — or exact, or hidden. Armor class held back, rolls without the dice, any creature kept off their screens until you reveal it.',
            },
            {
              title: 'Nothing stored, nothing to set up',
              body: "It works without an account. The board goes straight to their screens and is kept nowhere — stop sharing and it's gone.",
            },
          ]}
        />
        <p class="mt-6 mb-0">
          <a
            href="/features/player-view/"
            class="font-semibold text-accent no-underline hover:underline"
          >
            The player view, in detail →
          </a>
        </p>
      </Split>
    </section>

    {/* The shelf, and everything a table adds to it. */}
    <section class={`libraries mt-20 ${TEXT_COL}`}>
      <Split
        eyebrow="Your books, your monsters"
        heading="Bring the libraries you actually use"
        id="libraries-title"
        caption="A searchable compendium of creatures and spells, right next to the fight. Click through to read it."
        mediaClass="max-w-[26rem] justify-self-center lg:justify-self-end"
      >
        <button
          slot="media"
          type="button"
          class={`shot-thumb ${zoomTrigger} rounded-xl`}
          data-index="1"
          aria-label={`Enlarge screenshot: ${compendiumShot.alt}`}
        >
          <Picture
            src={compendiumShot.img}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            widths={[640, 1280]}
            sizes="(max-width: 1024px) 94vw, 26rem"
            alt={compendiumShot.alt}
            loading="lazy"
            class="block h-auto w-full"
          />
          <span class={zoomOverlay} aria-hidden="true">
            <span class={zoomBadge}><ZoomIcon /></span>
          </span>
        </button>
        <div class={CARD}>
          <h3 class="m-0 mb-3 text-base leading-relaxed font-bold text-text">
            Over 2000 creatures included
          </h3>
          <ul class="m-0 grid list-none gap-1.5 p-0 text-sm leading-relaxed text-muted">
            {
              shippedLibraries.map((name) => (
                <li class="flex gap-2">
                  <CheckIcon />
                  <span>{name}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 mb-2 text-sm leading-relaxed text-muted">
            And OpenFray's own, free to read and use:
          </p>
          <ul class="m-0 grid list-none gap-1.5 p-0 text-sm leading-relaxed text-muted">
            {
              libraries.map((l) => (
                <li class="flex gap-2">
                  <CheckIcon />
                  <a href={l.href} class="font-semibold text-accent">
                    {l.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="mt-4 mb-0 text-sm leading-normal text-muted">
          Plus a full homebrew editor, and a free importer that turns a D&amp;D&nbsp;Beyond creature
          page into an OpenFray creature —{' '}
          <a
            href={importerChrome}
            target="_blank"
            rel="noreferrer"
            class="font-semibold text-accent">Chrome</a
          >{' '}or{' '}
          <a
            href={importerFirefox}
            target="_blank"
            rel="noreferrer"
            class="font-semibold text-accent">Firefox</a
          >.
        </p>
        <p class="mt-4 mb-0">
          <a
            href="/features/libraries/"
            class="font-semibold text-accent no-underline hover:underline"
          >
            More about the libraries →
          </a>
        </p>
      </Split>
    </section>

    {
      /* Teaching into conversion: the first fight in the real buttons' own words,
      with the ask right underneath. */
    }
    <Band
      eyebrow="Start here"
      heading="Your first fight, in three steps"
      id="first-fight-title"
      align="center"
      class="mt-20"
    >
      <ol class="m-0 grid list-none gap-x-10 gap-y-6 p-0 lg:grid-cols-3">
        {
          firstFight.map((s, i) => (
            <li class="grid grid-cols-[2.25rem_1fr] gap-4">
              <span class="grid size-9 place-items-center rounded-full border border-accent text-sm font-bold text-accent">
                {i + 1}
              </span>
              <span class="pt-1">
                <span class="block text-base leading-snug font-bold text-text">{s.label}</span>
                <span class="mt-1 block text-sm leading-normal text-muted">{s.body}</span>
              </span>
            </li>
          ))
        }
      </ol>
      <div class="cta-row mt-10 flex flex-wrap justify-center gap-3">
        <Cta href="/console/">Open the console →</Cta>
        <Cta href="/docs/getting-started/" variant="ghost">Run your first fight</Cta>
      </div>
    </Band>

    <section class={`rest mt-20 ${TEXT_COL} text-left`} aria-labelledby="rest-title">
      <p class={`${EYEBROW} mb-4 text-center`}>The rest of the table</p>
      <h2 id="rest-title" class={`mx-auto mt-0 mb-8 max-w-[18ch] text-center ${DISPLAY_MD}`}>
        Everything else you'd expect
      </h2>
      <Cards layout="flow" items={rest} />
      {
        /* The positioning line stands apart from the checklist: it is how OpenFray
        sits at the table, not another feature. */
      }
      <div class="mx-auto mt-12 max-w-[44rem] text-center">
        <h3 class="m-0 mb-2 text-base leading-relaxed font-bold text-text">
          Plays beside your other tools
        </h3>
        <p class="m-0 text-base leading-relaxed text-muted">
          A paper map on the table, players rolling on D&amp;D&nbsp;Beyond, the fight on OpenFray.
          It slots in; it never asks to take over.
        </p>
      </div>
    </section>

    {
      /* The second conversion, seeded after the value is proven and never gating it:
      everything above works anonymous, and this section says exactly that first. */
    }
    <section class={`account mt-20 ${TEXT_COL} text-center`} aria-labelledby="account-title">
      <p class={`${EYEBROW} mb-4`}>When you're ready</p>
      <h2 id="account-title" class={`mx-auto mt-0 mb-5 max-w-[18ch] ${DISPLAY_MD}`}>
        Everything works without an account
      </h2>
      <p class={`${tagline} mx-auto max-w-[52rem]`}>
        The free account is for keeping. Sign in with Discord or Google and your fights, custom
        creatures, characters, and campaigns follow you between devices. Everything on this page
        works before you do.
      </p>
    </section>

    {
      /* One panel rather than another card grid: this is the page saying what it is,
      not another feature, and it should not read as one. */
    }
    <div class={`wrap-up mt-20 mb-4 ${TEXT_COL}`}>
      <Panel eyebrow="Open source" heading="Free to use, and built in the open" id="wrap-up-title">
        <div class="mt-8 grid gap-8 border-t border-border pt-8 sm:grid-cols-3">
          <div>
            <h3 class="m-0 mb-1.5 text-base leading-relaxed font-bold text-text">Version 1.0</h3>
            <p class="m-0 text-sm leading-normal text-muted">
              Out of beta, and running tables. Everything works in the browser with no account; sign
              in free and your fights follow you between devices.
            </p>
          </div>
          <div>
            <h3 class="m-0 mb-1.5 text-base leading-relaxed font-bold text-text">
              Open all the way down
            </h3>
            <p class="m-0 text-sm leading-normal text-muted">
              The code is AGPL-3.0 and every line of it is public. The creatures and rules in our
              own books are Creative Commons.
            </p>
          </div>
          <div>
            <h3 class="m-0 mb-1.5 text-base leading-relaxed font-bold text-text">
              Tell us anything
            </h3>
            <p class="m-0 text-sm leading-normal text-muted">
              A bug, a rule OpenFray gets wrong, or something your table needs and can't find — open
              an issue and it gets read.
            </p>
          </div>
        </div>
        <div slot="footer">
          <div class="cta-row flex flex-wrap gap-3">
            <Cta href="/console/">Open the console →</Cta>
            <Cta href="/docs/getting-started/" variant="ghost">Run your first fight</Cta>
          </div>
          <ul
            class="m-0 mt-8 flex list-none flex-wrap gap-x-6 gap-y-2 border-t border-border p-0 pt-6 text-sm leading-relaxed"
          >
            {
              wrapUpLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith('/') ? undefined : '_blank'}
                    rel={l.href.startsWith('/') ? undefined : 'noreferrer'}
                    class="font-semibold text-accent no-underline hover:underline"
                  >
                    {l.label} →
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </Panel>
    </div>
  </main>

  <Lightbox shots={zoomable} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { libraries } from '../data/libraries.ts';
import { SITE, WEBSITE_ID, PUBLISHER_ID, breadcrumbs } from '../data/seo.ts';

const title = 'Compendium — OpenFray’s own DnD 5e creature libraries';
const description =
  'The creature libraries OpenFray writes and publishes in full, free to read: original ' +
  'Dungeons and Dragons 5e stat blocks you can use at the table or in the console.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE}/compendium/#page`,
    name: 'Compendium',
    description,
    url: `${SITE}/compendium/`,
    isPartOf: { '@id': WEBSITE_ID },
    publisher: { '@id': PUBLISHER_ID },
    hasPart: libraries
      .filter((library) => library.available)
      .map((library) => ({
        '@type': 'Book',
        name: library.name,
        url: `${SITE}${library.href}`,
        author: { '@id': PUBLISHER_ID },
      })),
  },
  breadcrumbs([
    { name: 'OpenFray', url: '/' },
    { name: 'Compendium', url: '/compendium/' },
  ]),
];

const published = libraries.filter((library) => library.available);
---

<Layout
  title={title}
  description={description}
  keywords={['OpenFray compendium', 'DnD 5e bestiary', 'free 5e stat blocks']}
  schema={schema}
>
  <main class="doc">
    <h1>Compendium</h1>

    <p class="lead">
      The creature libraries OpenFray writes itself, published here in full and free to read.
    </p>

    <p>
      Each one is built into <a href="/console/">the console</a> as well — turn it on in{' '}
      <strong>Settings</strong> and its creatures appear in <strong>Add creature</strong>, ready to
      roll. The console also ships the official Basic Rules and the Tome of Beasts books.
    </p>

    <ul
      class="library-grid mt-7 grid list-none grid-cols-[repeat(auto-fit,minmax(17rem,1fr))] gap-4 p-0"
    >
      {
        published.map((library) => (
          <li>
            <a
              class="block h-full rounded-xl border border-border bg-panel px-5 py-4.5 no-underline transition-[border-color,transform] hover:-translate-y-0.5 hover:border-accent"
              href={library.href}
            >
              <span class="library-edition mb-1 block text-xs leading-relaxed tracking-widest text-accent uppercase">
                {library.edition}
              </span>
              <strong class="block text-base leading-relaxed text-text">{library.name}</strong>
              <span class="library-blurb mt-1.5 block text-sm leading-normal text-muted">
                {library.blurb}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

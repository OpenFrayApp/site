---
// The print edition, LOCAL ONLY — assemble-site.mjs drops this route from dist/ and the
// sitemap filter hides it. Run `npm run dev -w site`, open /brood-and-bloom/print/,
// print to PDF. Pagination takes about a minute and the page is blank while it runs.
//
// It is a page rather than a generator so the book renders through the site's own
// components and stylesheet — see the Waking Garden's print.astro, which this mirrors.
import { getCollection, render } from 'astro:content';
import { creatures } from '../../data/broodAndBloom.ts';
import { formatCr } from '../../data/statblock.ts';
import '../../styles/global.css';
import '../../styles/book.css';

const chapters = (await getCollection('brood-and-bloom')).sort(
  (a, b) => a.data.order - b.data.order,
);
const parts = await Promise.all(
  chapters.map(async (c) => ({ ...c, Content: (await render(c)).Content })),
);

const crs = creatures.map((c) => c.cr ?? 0);
const range = `${formatCr(Math.min(...crs))}–${formatCr(Math.max(...crs))}`;
---

<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Brood & Bloom — print edition</title>
  </head>
  <body class="print-book">
    <section class="cover">
      <p class="cover-kicker">OpenFray · Compendium</p>
      <h1 class="cover-title">Brood &<br />Bloom</h1>
      <p class="cover-subtitle">A bestiary of parasites, compatible with 5.5e and 5e.</p>
      <hr class="cover-rule" />
      <p class="cover-lede">
        Sixty-seven creatures whose lives run through other bodies — living, dead, or built — with
        the rules for what they leave behind in the people, the ground, and the buildings that
        survive them, the order of physicians that has been writing all of it down for longer than
        anyone can remember, and the cult that reads the same files and welcomes what is in them.
      </p>
      <p class="cover-meta">
        <strong>{creatures.length} creatures</strong> · CR {range} · 3 broods, 10 lines, 7 diseases ·
        23 spells<br />
        Built for OpenFray, a free combat console for Game Masters — openfray.app
      </p>
      <p class="cover-legal">
        Compatible with 5.5e (2024) and 5e (2014). Not affiliated with, endorsed, sponsored, or
        specifically approved by Wizards of the Coast LLC.
      </p>
    </section>

    {
      parts.map((part) => (
        <section class="chapter">
          <header class="chapter-head">
            {part.data.eyebrow && <p class="chapter-eyebrow">{part.data.eyebrow}</p>}
            <h1 class="chapter-title">{part.data.title}</h1>
          </header>
          <div class="book-body chapter-body">
            <part.Content />
          </div>
        </section>
      ))
    }

    <script>
      import { paginateBook } from '../../lib/paginate.ts';

      paginateBook({ name: 'Brood & Bloom', expectedTerms: 23 });
    </script>
  </body>
</html>

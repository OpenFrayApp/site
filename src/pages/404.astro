---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import { hero, tagline } from '../data/hero.ts';
---

<Layout
  title="Page not found — OpenFray"
  description="That page doesn't exist. The link may be broken, or the page may have moved."
>
  <main class={hero}>
    <h1
      class="mt-0 mb-4 text-[clamp(2.6rem,8vw,4.5rem)] leading-[1.02] font-extrabold tracking-tight"
    >
      404
    </h1>
    <p class={`${tagline} mb-7`}>
      <strong>That page doesn't exist.</strong> The link may be broken, or the page may have moved.
    </p>
    <Cta href="/">Back to the home page →</Cta>
    <p class="disclaimer">
      Looking for the app? <a href="/console/">Open the console</a>.
    </p>
  </main>
</Layout>

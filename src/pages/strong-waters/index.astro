---
import { getCollection } from 'astro:content';
import Cta from '../../components/Cta.astro';
import { STRONG_WATERS } from '../../data/books.ts';
import BookLayout from '../../layouts/BookLayout.astro';

const chapters = (await getCollection('strong-waters')).sort((a, b) => a.data.order - b.data.order);
// An empty collection means the content layer didn't load, not that the book is empty —
// usually a dev server still running against a `site/.astro` that was cleared underneath
// it. Say so, rather than failing on `chapters[0].id` two lines down.
if (!chapters.length) {
  throw new Error(
    'Strong Waters: the content collection is empty. Restart the dev server so Astro re-syncs site/.astro.',
  );
}

const title = 'On Strong Waters and Potent Simples — DnD 5e drink, drugs and herbalism';
const description =
  'An apothecary’s catalog for Dungeons and Dragons 5e: the drink of the world and the ' +
  'herbs that change a body, with the rules for intoxication, craving and overdose. Free ' +
  'to read, and built into the OpenFray combat console.';
---

<BookLayout
  title={title}
  description={description}
  book={STRONG_WATERS}
  heading="On Strong Waters and Potent Simples"
>
  <p class="lead">
    Being the collected notes of Hesper Aldwine, apothecary. Compatible with 5.5e and 5e.
  </p>

  <p>
    A working book, not a grimoire: what a plant is, where it grows, what heat does to it, what it
    does to a body, and what to do when it has done too much. The drink of the world from small beer
    to the things that come off a still, the herbs that steady a hand or take it, and the rules for
    the three things every table ends up improvising — how drunk, how badly wanted, and how much is
    too much.
  </p>

  <p class="book-cta-row mt-6 mb-0 flex flex-wrap gap-3">
    <Cta href="/console/">Open the console</Cta>
    <Cta href={`/strong-waters/${chapters[0].id}/`} variant="ghost">Start reading</Cta>
  </p>

  <h2>Contents</h2>

  <ol class="book-contents mt-4 grid list-none gap-2.5 p-0">
    {
      chapters.map((chapter) => (
        <li>
          <a
            class="block rounded-lg border border-border bg-panel px-4 py-3.5 no-underline transition-[border-color,transform] hover:-translate-y-px hover:border-accent"
            href={`/strong-waters/${chapter.id}/`}
          >
            {chapter.data.eyebrow && (
              <span class="num block text-xs leading-relaxed tracking-widest text-faint uppercase">
                {chapter.data.eyebrow}
              </span>
            )}
            <strong class="text-base leading-relaxed text-text">{chapter.data.label}</strong>
            <span class="blurb mt-0.5 block text-sm leading-normal text-muted">
              {chapter.data.description}
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <h2>Run it in the console</h2>

  <p>
    This book carries no creatures. What it puts in OpenFray is its spells, and the presets for the
    tracks it runs on — intoxication, craving, and the states a measure leaves behind. Open{' '}
    <a href="/console/">the console</a>, then turn on <strong
      >On Strong Waters and Potent Simples</strong
    >{' '}
    in <strong>Settings</strong> (the gear at the top right). After that its spells show up in the compendium
    and in <strong>Cast spell</strong>, and its presets in <strong>Apply effect</strong>. See <a
      href="/docs/reference/settings/">Settings and appearance</a
    > in the handbook.
  </p>
</BookLayout>

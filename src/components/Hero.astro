---
/** A split hero: eyebrow, heading, tagline, and CTAs on one side, a screenshot or a
 *  silent video loop on the other. Below lg the text leads and the media follows. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Cta from './Cta.astro';
import ZoomIcon from './ZoomIcon.astro';
import { zoomTrigger, zoomOverlay, zoomBadge } from '../data/lightbox.ts';
import { EYEBROW, DISPLAY_LG, SHOT_FRAME } from '../data/pageStyles.ts';

interface Props {
  eyebrow?: string;
  heading: string;
  tagline?: string;
  /** The hero owns the page's h1 by default; the lab page demos several, as h2. */
  level?: 'h1' | 'h2';
  /** Which side the media sits on at lg. */
  side?: 'left' | 'right';
  ctas?: { label: string; href: string; ghost?: boolean }[];
  image?: { src: ImageMetadata; alt: string };
  /** A silent loop. It autoplays muted; a reduced-motion reader gets it paused, with
   *  controls to run it deliberately (see the script below). */
  video?: { src: string; poster?: string; label: string };
  /** Wraps the image in the page's lightbox trigger, opening this shot index. */
  zoomIndex?: number;
  /** Extra classes for the heading (the home page passes its larger scale). */
  headingClass?: string;
  /** Extra classes for the media column, e.g. a max width for a portrait shot. */
  mediaClass?: string;
  /** Lets the media run past the column to the viewport edge on its own side, the
   *  way the app runs past a window. Only at lg, and only for restrained media —
   *  the text column still owns the layout. */
  bleed?: boolean;
}

const {
  eyebrow,
  heading,
  tagline,
  level = 'h1',
  side = 'right',
  ctas = [],
  image,
  video,
  headingClass = DISPLAY_LG,
  mediaClass = '',
  bleed = false,
  zoomIndex,
} = Astro.props;
const Heading = level;
const bleedClass = bleed
  ? side === 'left'
    ? 'lg:ml-[calc(50%-50vw)]'
    : 'lg:mr-[calc(50%-50vw)]'
  : '';
---

<section class="hero-split grid items-center gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
  <div class={`text-left ${side === 'left' ? 'lg:order-2' : ''}`}>
    {eyebrow && <p class={`${EYEBROW} mb-5`}>{eyebrow}</p>}
    <Heading class={`mt-0 mb-5 ${headingClass}`}>{heading}</Heading>
    {tagline && <p class="tagline m-0 text-lg leading-[1.55] text-muted">{tagline}</p>}
    {
      ctas.length > 0 && (
        <div class="cta-row mt-8 flex flex-wrap gap-3">
          {ctas.map((c) => (
            <Cta href={c.href} variant={c.ghost ? 'ghost' : 'solid'}>
              {c.label}
            </Cta>
          ))}
        </div>
      )
    }
    <slot />
  </div>

  <figure class={`m-0 ${side === 'left' ? 'lg:order-1' : ''} ${bleedClass} ${mediaClass}`}>
    {
      image && zoomIndex === undefined && (
        <Picture
          src={image.src}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[640, 1280]}
          sizes="(max-width: 1024px) 94vw, 34rem"
          alt={image.alt}
          loading="eager"
          class={SHOT_FRAME}
        />
      )
    }
    {
      image && zoomIndex !== undefined && (
        <button
          type="button"
          class={`shot-thumb ${zoomTrigger} rounded-xl`}
          data-index={zoomIndex}
          aria-label={`Enlarge screenshot: ${image.alt}`}
        >
          <Picture
            src={image.src}
            formats={['avif', 'webp']}
            fallbackFormat="png"
            widths={[640, 1280]}
            sizes="(max-width: 1024px) 94vw, 34rem"
            alt={image.alt}
            loading="eager"
            class={SHOT_FRAME}
          />
          <span class={zoomOverlay} aria-hidden="true">
            <span class={zoomBadge}>
              <ZoomIcon />
            </span>
          </span>
        </button>
      )
    }
    {
      video && (
        <video
          class={`motion-loop ${SHOT_FRAME}`}
          src={video.src}
          poster={video.poster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={video.label}
        />
      )
    }
    <slot name="media" />
  </figure>
</section>

<script>
  // A loop is furniture, not content, so it must not run for a reader who asked for
  // less motion: pause it and hand over the controls instead of guessing.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video.motion-loop').forEach((v) => {
      v.pause();
      v.controls = true;
    });
  }
</script>

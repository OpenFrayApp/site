---
// The magnifier that appears over a screenshot on hover, marking it as openable. It
// exists as a component because every zoomable figure on the home page draws the same
// one, and the gallery strip may want it too.
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="size-6"
>
  <circle cx="11" cy="11" r="7"></circle>
  <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
  <line x1="11" y1="8" x2="11" y2="14"></line>
  <line x1="8" y1="11" x2="14" y2="11"></line>
</svg>

---
/** The scaffold every feature landing page shares: a split hero carrying a screenshot
 *  or a silent loop, the page's own sections (slot), the handbook links, and the
 *  closing panel with the console CTA and the sibling features. `shots` fills the
 *  lightbox; a hero image doubles as its first entry, so the split-sized picture
 *  still opens in full. */
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Panel from './Panel.astro';
import Cta from './Cta.astro';
import Lightbox from './Lightbox.astro';
import { hero } from '../data/hero.ts';
import { features } from '../data/features.ts';
import { EYEBROW, TEXT_COL } from '../data/pageStyles.ts';

interface Shot {
  img: ImageMetadata;
  alt: string;
}
interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  /** The hero's screenshot; also the lightbox's first shot when it is in `shots`. */
  image?: Shot;
  /** The hero's silent loop, instead of a screenshot. */
  video?: { src: string; poster?: string; label: string };
  shots?: Shot[];
  handbook: { label: string; href: string }[];
  current: string;
  /** Constrains the hero figure; a portrait shot must not fill the column. */
  mediaClass?: string;
}

const {
  title,
  description,
  heading,
  lede,
  image,
  video,
  shots = [],
  handbook,
  current,
  mediaClass = '',
} = Astro.props;
const siblings = features.filter((f) => f.href !== current);
---

<Layout title={title} description={description}>
  <main class={`${hero} overflow-x-clip`}>
    <div class={TEXT_COL}>
      <Hero
        eyebrow="Features"
        heading={heading}
        tagline={lede}
        video={video}
        image={image ? { src: image.img, alt: image.alt } : undefined}
        zoomIndex={image ? 0 : undefined}
        ctas={[
          { label: 'Open the console →', href: '/console/' },
          { label: 'Run your first fight', href: '/docs/getting-started/', ghost: true },
        ]}
        mediaClass={mediaClass}
      />
    </div>

    <slot />

    <section class={`mt-20 ${TEXT_COL} text-left`} aria-label="In the handbook">
      <p class={`${EYEBROW} mb-4`}>In the handbook</p>
      <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-sm leading-relaxed">
        {
          handbook.map((h) => (
            <li>
              <a href={h.href} class="font-semibold text-accent no-underline hover:underline">
                {h.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class={`mt-20 mb-4 ${TEXT_COL}`}>
      <Panel heading="See it hold a real fight">
        <div slot="footer">
          <div class="cta-row flex flex-wrap gap-3">
            <Cta href="/console/">Open the console →</Cta>
            <Cta href="/docs/getting-started/" variant="ghost">Run your first fight</Cta>
          </div>
          <ul
            class="m-0 mt-8 flex list-none flex-wrap gap-x-6 gap-y-2 border-t border-border p-0 pt-6 text-sm leading-relaxed"
          >
            {
              siblings.map((f) => (
                <li>
                  <a href={f.href} class="font-semibold text-accent no-underline hover:underline">
                    {f.name} →
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </Panel>
    </div>
  </main>

  {shots.length > 0 && <Lightbox shots={shots} />}
</Layout>

---
/** A manual slider for a media slot: one slide visible, arrows and dots to move. No
 *  autoplay — a reader flips through claims at their own pace, and a carousel that
 *  moves itself is furniture the eye learns to skip. Ids must be page-unique. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { SHOT_FRAME } from '../data/pageStyles.ts';

interface Slide {
  image: { src: ImageMetadata; alt: string };
  /** One line under the picture saying what this slide proves. */
  caption?: string;
}
interface Props {
  /** Names the slider for assistive tech, e.g. “What the board keeps hold of”. */
  label: string;
  slides: Slide[];
}

const { label, slides } = Astro.props;

const arrowClass =
  'slider-arrow grid size-9 cursor-pointer place-items-center rounded-full border ' +
  'border-border bg-panel text-muted transition-[color,border-color] ' +
  'hover:border-accent hover:text-text';
---

<div
  class="slider"
  data-slider
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  {
    slides.map((s, i) => (
      <figure
        class={`m-0 ${i === 0 ? '' : 'hidden'}`}
        data-slide={i}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}`}
      >
        <Picture
          src={s.image.src}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[560, 1120]}
          sizes="(max-width: 1024px) 94vw, 32rem"
          alt={s.image.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          class={SHOT_FRAME}
        />
        {s.caption && (
          <figcaption class="mt-3 text-sm leading-relaxed text-muted">{s.caption}</figcaption>
        )}
      </figure>
    ))
  }

  <div class="mt-4 flex items-center gap-4">
    <button type="button" class={arrowClass} data-prev aria-label="Previous slide">
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
      >
    </button>
    <div class="flex gap-2">
      {
        slides.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            aria-label={`Go to slide ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
            class="size-2.5 cursor-pointer rounded-full border-0 bg-border p-0 transition-[background-color] aria-[current]:bg-accent"
          />
        ))
      }
    </div>
    <button type="button" class={arrowClass} data-next aria-label="Next slide">
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
      >
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let current = 0;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, n) => s.classList.toggle('hidden', n !== current));
      dots.forEach((d, n) => {
        if (n === current) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => show(n)));
  });
</script>

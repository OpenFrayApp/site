<main class="mx-auto w-full max-w-md px-6 py-12" data-auth-callback>
  <h1 class="text-3xl leading-tight font-bold text-text">Completing sign-in</h1>
  <p data-auth-status role="status" aria-live="polite" class="mt-4 text-muted">
    Checking this sign-in attempt…
  </p>
  <p class="mt-6"><a data-auth-retry href="/sign-in/">Try signing in again</a></p>
  <noscript><p class="mt-4">Enable JavaScript to complete sign-in.</p></noscript>
</main>

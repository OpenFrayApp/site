---
/** The accordion split: exclusive details on one side, the open item's picture beside
 *  them. Without JavaScript it is still a working accordion — the browser's own
 *  `details name=` exclusivity does the switching, and the first picture stands. The
 *  script only keeps the media pane in step and stops the group closing entirely. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { SHOT_FRAME } from '../data/pageStyles.ts';

interface Item {
  id: string;
  title: string;
  body: string;
  image?: { src: ImageMetadata; alt: string };
}
interface Props {
  /** Groups the details elements; must be unique per accordion on the page. */
  name: string;
  /** Which side the media pane sits on at lg. */
  side?: 'left' | 'right';
  items: Item[];
}

const { name, side = 'right', items } = Astro.props;
const hasMedia = items.some((i) => i.image);
---

<div
  class={`accordion text-left ${hasMedia ? 'grid items-center gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-12' : ''}`}
  data-accordion
>
  <div class={side === 'left' && hasMedia ? 'lg:order-2' : ''}>
    {
      items.map((item, i) => (
        <details
          name={name}
          open={i === 0}
          data-item={item.id}
          class="group border-l-2 border-border pl-5 not-first:mt-2 open:border-accent"
        >
          <summary class="cursor-pointer list-none py-3 text-lg leading-snug font-bold text-muted transition-[color] group-open:text-text hover:text-text [&::-webkit-details-marker]:hidden">
            {item.title}
          </summary>
          <p class="mt-0 mb-4 text-base leading-relaxed text-muted">{item.body}</p>
        </details>
      ))
    }
  </div>

  {
    hasMedia && (
      <figure class={`m-0 ${side === 'left' ? 'lg:order-1' : ''}`}>
        {items.map(
          (item, i) =>
            item.image && (
              <Picture
                src={item.image.src}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                widths={[560, 1120]}
                sizes="(max-width: 1024px) 94vw, 32rem"
                alt={item.image.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                class={`${SHOT_FRAME} ${i === 0 ? '' : 'hidden'}`}
                data-media={item.id}
              />
            ),
        )}
      </figure>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const details = [...root.querySelectorAll<HTMLDetailsElement>('details[data-item]')];

    // Swap the media pane to the open item. `details name=` already closes the others.
    const sync = () => {
      const open = details.find((d) => d.open) ?? details[0];
      root.querySelectorAll<HTMLElement>('[data-media]').forEach((m) => {
        m.classList.toggle('hidden', m.dataset.media !== open.dataset.item);
      });
    };

    details.forEach((d) => {
      // Closing the open item would leave the group empty and the pane orphaned; the
      // toggle is for moving between items, so the open one stays open.
      d.querySelector('summary')?.addEventListener('click', (e) => {
        if (d.open) e.preventDefault();
      });
      d.addEventListener('toggle', sync);
    });
  });
</script>

---
// The small line icon beside a feature in the megamenu. The whole element is built
// as a string and emitted through a Fragment: Astro's compiler treats an <svg>
// subtree as raw literal markup, so neither expressions nor set:html work inside one.
interface Props {
  name: 'rolling' | 'tracking' | 'player-view' | 'libraries';
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const shapes: Record<Props['name'], string> = {
  rolling: [
    '<rect x="3" y="3" width="18" height="18" rx="3"/>',
    '<circle cx="8" cy="8" r="0.6" fill="currentColor"/>',
    '<circle cx="16" cy="8" r="0.6" fill="currentColor"/>',
    '<circle cx="12" cy="12" r="0.6" fill="currentColor"/>',
    '<circle cx="8" cy="16" r="0.6" fill="currentColor"/>',
    '<circle cx="16" cy="16" r="0.6" fill="currentColor"/>',
  ].join(''),
  tracking:
    '<path d="m3 7 2 2 4-4"/><path d="m3 17 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
  'player-view': '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  libraries:
    '<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>',
};

const svg =
  `<svg class="${className}" viewBox="0 0 24 24" fill="none" stroke="currentColor" ` +
  `stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">` +
  `${shapes[name]}</svg>`;
---

<Fragment set:html={svg} />

---
// Every creature in the book, grouped by challenge rating or by type. Built from the
// compendium JSON the console fetches, so it cannot disagree with the stat blocks.
// Used by the two appendix chapters, which is how the site and the print edition share
// it — and in print each link becomes a page number, resolved by print.astro.
import { getCollection } from 'astro:content';
import { creatures, creatureSlug, formatCr, titleCase } from '../data/wakingGarden.ts';

interface Props {
  by: 'cr' | 'type';
}

const { by } = Astro.props;

// Which chapter holds each creature. Only the MDX knows the book's arrangement, so it
// is read back out of the <Creature> tags rather than kept as a second list that drifts.
const chapterOf = new Map<string, string>();
for (const chapter of await getCollection('waking-garden')) {
  for (const [, name] of (chapter.body ?? '').matchAll(/<Creature\b[^>]*name="([^"]+)"/g)) {
    chapterOf.set(name, chapter.id);
  }
}

const href = (name: string) => {
  const anchor = `#c-${creatureSlug(name)}`;
  const chapter = chapterOf.get(name);
  return chapter ? `/the-waking-garden/${chapter}/${anchor}` : anchor;
};

// "Swarm of Tiny Beasts" is a Beast; grouping on the raw string scatters four creatures
// into three groups of one.
const baseType = (type: string) => {
  const word = titleCase(String(type).split(' ').pop() ?? '');
  return word.endsWith('s') ? word.slice(0, -1) : word;
};

const keyOf = (c: (typeof creatures)[number]) => (by === 'cr' ? (c.cr ?? 0) : baseType(c.type));
const labelOf = (c: (typeof creatures)[number]) =>
  by === 'cr'
    ? `Challenge ${formatCr(c.cr ?? 0)} (${(c.xp ?? 0).toLocaleString('en-US')} XP)`
    : baseType(c.type);

const groups = new Map<
  string | number,
  { label: string; entries: { name: string; href: string }[] }
>();
for (const c of [...creatures].sort((a, b) => a.name.localeCompare(b.name))) {
  const key = keyOf(c);
  if (!groups.has(key)) groups.set(key, { label: labelOf(c), entries: [] });
  groups.get(key)!.entries.push({ name: c.name, href: href(c.name) });
}

const ordered = [...groups.keys()]
  .sort((a, b) =>
    typeof a === 'number' && typeof b === 'number' ? a - b : String(a).localeCompare(String(b)),
  )
  .map((key) => groups.get(key)!);
---

<div class="creature-index">
  {
    ordered.map((group) => (
      <section class="index-band">
        <h3 class="index-band-head">{group.label}</h3>
        <ul class="index-list">
          {group.entries.map((entry) => (
            <li>
              <a href={entry.href}>{entry.name}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

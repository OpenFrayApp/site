---
import { renderMarkdown } from '../data/markdown.ts';

// A few stat-block texts carry block markdown — the Perennial's Graft table, the
// Gardener's bulleted Patient trait.

interface Props {
  /** The name printed in bold before the text, e.g. "Grafted of Every Garden". */
  label: string;
  text: string;
}

const { label, text } = Astro.props;
const html = await renderMarkdown(text);
---

{
  /* The rendered markdown inside carries no classes, so its elements are styled by the
    `.sb-entry-block` rules in waking-garden.css — the one place utilities can't reach. */
}
<div class="sb-entry sb-entry-block m-0 mb-2.5 text-muted">
  <p><strong class="text-text">{label}.</strong></p>
  <Fragment set:html={html} />
</div>

// Render the preparation cost catalog or appendix index from their shared records.
import { preparations, preparationAnchor } from '../data/broodAndBloomPreparations.ts';

interface Props {
  view: 'catalog' | 'index';
}

const { view } = Astro.props;
const onDetailedPage = view === 'catalog';

/** Link one catalog row to its canonical detailed entry. */
const href = (name: string) => {
  const anchor = preparationAnchor(name);
  return onDetailedPage ? `#${anchor}` : `/brood-and-bloom/chapter-7/#${anchor}`;
};
---

<div class="table-scroll">
  <table class="preparation-table">
    <thead>
      <tr>
        <th>Preparation</th>
        <th>Form</th>
        <th>Brood</th>
        <th>Rarity</th>
        <th>Price</th>
        <th>Source</th>
        {view === 'index' && <th>What it does</th>}
      </tr>
    </thead>
    <tbody>
      {
        preparations.map((item) => (
          <tr>
            <td>
              <a href={href(item.name)}>{item.name}</a>
            </td>
            <td>{item.form}</td>
            <td>{item.brood}</td>
            <td>{item.rarity}</td>
            <td>{item.price}</td>
            <td>{item.source}</td>
            {view === 'index' && <td>{item.summary}</td>}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

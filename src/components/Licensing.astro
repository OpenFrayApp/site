---
// The licensing notice for a first-party OpenFray library. This is the canonical
// wording — CREDITS.md and the print edition's licensing page carry the same terms,
// and any future library renders this component rather than restating them.
//
// It renders as a chapter of its own, so the page heading names the library and this
// opens on the first term. It takes no `work` for that reason.
//
// The web edition carries no fineprint line: the site footer already states the edition
// compatibility, the Wizards of the Coast disclaimer, and the AGPL on every page. The
// print edition still needs one, and keeps it in its own source — it has no footer.
interface Props {
  year: number;
}

const { year } = Astro.props;
const CC_BY = 'https://creativecommons.org/licenses/by/4.0/legalcode.en';
---

<p>
  <strong>Creatures, spells, items, and mechanics.</strong> The stat blocks, the spells, the items, and
  the game mechanics — every field of a creature or spell entry other than a creature's description —
  are licensed under the{' '}
  <a href={CC_BY} target="_blank" rel="noreferrer"
    >Creative Commons Attribution 4.0 International License</a
  > (CC BY 4.0). You are free to share and adapt this material, including commercially, provided you give
  appropriate credit to OpenFray (<a href="https://openfray.app">openfray.app</a>), provide a link
  to the license, and indicate if changes were made.
</p>

<p>
  <strong>Lore, art, and prose.</strong> All descriptive and narrative text — including each creature's
  description and the chapter text of this work — together with any artwork, is © {year} OpenFray, all
  rights reserved. It is published here to be read, and is not licensed for reuse in other products.
</p>

<p>
  <strong>Game rules.</strong> Conditions, spell names, and rules terminology come from the System Reference
  Document 5.2.1, used under CC BY 4.0.
</p>

{
  /* The prose here deliberately carries no utilities: it renders inside .book-body and
    inherits its rules, so classing it would only duplicate them. Only the two elements
    with a look of their own are converted. */
}
<blockquote
  class="book-attribution my-5 rounded-lg border border-border border-l-[3px] border-l-accent bg-panel px-4 py-3.5 text-sm leading-relaxed text-muted"
>
  This work includes material from the System Reference Document 5.2.1 (“SRD 5.2.1”) by Wizards of
  the Coast LLC, available at <a
    href="https://www.dndbeyond.com/srd"
    target="_blank"
    rel="noreferrer">dndbeyond.com/srd</a
  >. The SRD 5.2.1 is licensed under the Creative Commons Attribution 4.0 International License,
  available at{' '}
  <a href="https://creativecommons.org/licenses/by/4.0/legalcode" target="_blank" rel="noreferrer"
    >creativecommons.org/licenses/by/4.0/legalcode</a
  >.
</blockquote>

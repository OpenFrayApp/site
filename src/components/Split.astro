---
/** A text-and-proof split: prose on one side, a picture on the other. The picture is
 *  cropped to the claim it proves and holds half the row, so neither side dwarfs the
 *  other. Pass the image, or fill the media slot with a zoom-wrapped figure. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { EYEBROW, DISPLAY_MD, SHOT_FRAME } from '../data/pageStyles.ts';

interface Props {
  eyebrow?: string;
  heading?: string;
  id?: string;
  /** Which side the media sits on at lg. */
  side?: 'left' | 'right';
  image?: { src: ImageMetadata; alt: string };
  caption?: string;
  mediaClass?: string;
}

const { eyebrow, heading, id, side = 'right', image, caption, mediaClass = '' } = Astro.props;
---

<section class="split text-left" aria-labelledby={heading && id ? id : undefined}>
  {eyebrow && <p class={`${EYEBROW} mb-4`}>{eyebrow}</p>}
  {
    heading && (
      <h2 id={id} class={`mt-0 mb-8 max-w-[18ch] ${DISPLAY_MD}`}>
        {heading}
      </h2>
    )
  }
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div class={`text-base leading-relaxed text-muted ${side === 'left' ? 'lg:order-2' : ''}`}>
      <slot />
    </div>
    <figure class={`m-0 ${side === 'left' ? 'lg:order-1' : ''} ${mediaClass}`}>
      <slot name="media">
        {
          image && (
            <Picture
              src={image.src}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[560, 1120]}
              sizes="(max-width: 1024px) 94vw, 29rem"
              alt={image.alt}
              loading="lazy"
              class={SHOT_FRAME}
            />
          )
        }
      </slot>
      {
        caption && (
          <figcaption class="mt-3 text-sm leading-relaxed text-muted">{caption}</figcaption>
        )
      }
    </figure>
  </div>
</section>

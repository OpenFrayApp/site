---
import type { Action } from '../../../src/schema/action.ts';
import StatText from './StatText.astro';
import { hasBlockMarkdown, rechargeLabel } from '../data/statblock.ts';

interface Props {
  heading: string;
  actions: Action[];
  /** The preamble printed under a Legendary Actions heading. */
  note?: string;
}

const { heading, actions, note } = Astro.props;

/** The full bold label a stat block prints before an action's text. */
const label = (action: Action): string =>
  action.name +
  rechargeLabel(action.recharge) +
  (action.legendaryCost && action.legendaryCost > 1
    ? ` (Costs ${action.legendaryCost} Actions)`
    : '');
---

{
  actions.length > 0 && (
    <div class="sb-section mt-3 border-t border-border pt-3">
      <h4 class="m-0 mb-2 text-xs font-bold tracking-widest text-accent uppercase">{heading}</h4>
      {note && <p class="sb-note m-0 mb-3 text-sm text-faint italic">{note}</p>}
      {actions.map((action) =>
        action.text && hasBlockMarkdown(action.text) ? (
          <StatText label={label(action)} text={action.text} />
        ) : (
          <p class="sb-entry m-0 mb-2.5 text-muted">
            <strong class="text-text">{label(action)}.</strong> {action.text}
          </p>
        ),
      )}
    </div>
  )
}

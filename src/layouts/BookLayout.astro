---
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import BookNavigation from '../components/BookNavigation.astro';
import { WAKING_GARDEN, type Book } from '../data/books.ts';
import { SITE, WEBSITE_ID, PUBLISHER_ID, breadcrumbs } from '../data/seo.ts';
import '../styles/book.css';

interface Props {
  title: string;
  description: string;
  /** Which bestiary book the page belongs to. */
  book?: Book;
  /** Slug of the current chapter, or undefined on the book's front page. */
  current?: string;
  eyebrow?: string;
  heading: string;
  /** The chapter's own headings, for the in-page nav under the sidebar entry. */
  headings?: MarkdownHeading[];
  keywords?: string[];
}

const {
  title,
  description,
  book = WAKING_GARDEN,
  current,
  eyebrow,
  heading,
  headings = [],
  keywords = [],
} = Astro.props;

const chapters = (await getCollection(book.collection)).sort((a, b) => a.data.order - b.data.order);

const index = chapters.findIndex((c) => c.id === current);
const previous = index > 0 ? chapters[index - 1] : undefined;
const next = index >= 0 && index < chapters.length - 1 ? chapters[index + 1] : undefined;
const base = book.base;

const pagerLink =
  'flex-1 rounded-lg border border-border bg-panel px-4 py-3 font-semibold text-text ' +
  'no-underline transition-[border-color] hover:border-accent';
// `leading-relaxed` is not decoration: a Tailwind `text-*` utility also sets a
// line-height, which would otherwise silently replace the 1.6 these inherit from body.
const pagerLabel = 'block text-xs leading-relaxed font-medium tracking-widest text-faint uppercase';

const BOOK_ID = `${SITE}${base}/#book`;
const bookNode = {
  '@type': 'Book',
  '@id': BOOK_ID,
  name: book.name,
  url: `${SITE}${base}/`,
  author: { '@id': PUBLISHER_ID },
  publisher: { '@id': PUBLISHER_ID },
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  genre: 'Tabletop role-playing game supplement',
  about: [
    { '@type': 'Thing', name: 'Dungeons and Dragons 5.5e' },
    { '@type': 'Thing', name: 'Tabletop role-playing games' },
  ],
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
};

const crumbs = [
  { name: 'OpenFray', url: '/' },
  { name: 'Compendium', url: '/compendium/' },
  { name: book.name, url: `${base}/` },
];

const schema = current
  ? [
      bookNode,
      {
        '@type': 'Article',
        '@id': `${SITE}${base}/${current}/#article`,
        headline: heading,
        description,
        url: `${SITE}${base}/${current}/`,
        inLanguage: 'en',
        isPartOf: { '@id': BOOK_ID },
        author: { '@id': PUBLISHER_ID },
        publisher: { '@id': PUBLISHER_ID },
      },
      breadcrumbs([...crumbs, { name: heading, url: `${base}/${current}/` }]),
    ]
  : [bookNode, breadcrumbs(crumbs)];
---

<Layout title={title} description={description} keywords={keywords} schema={schema}>
  <div
    class:list={[
      'book mx-auto grid w-full max-w-5xl items-start px-6 pb-12 max-[900px]:grid-cols-[minmax(0,1fr)] max-[900px]:gap-0 max-[560px]:px-4 max-[560px]:pb-10',
      current ? 'grid-cols-[14rem_minmax(0,1fr)] gap-8' : 'grid-cols-[minmax(0,1fr)]',
    ]}
  >
    <BookNavigation {book} {chapters} {current} {headings} />

    <main class="book-main min-w-0">
      <header class="book-head pt-4 pb-2">
        {
          eyebrow && (
            <p class="book-eyebrow m-0 mb-1.5 text-xs leading-relaxed font-bold tracking-widest text-accent uppercase">
              {eyebrow}
            </p>
          )
        }
        <h1
          class="mt-0 mb-5 border-b-[3px] border-accent pb-5 text-[clamp(2rem,5vw,3rem)] leading-[1.05] font-bold tracking-tight"
        >
          {heading}
        </h1>
      </header>

      <div class="book-body">
        <slot />
      </div>

      <nav class="book-pager mt-14 flex gap-4 max-[560px]:flex-col" aria-label="Chapters">
        {
          previous && (
            <a class={pagerLink} href={`${base}/${previous.id}/`}>
              <span class={pagerLabel}>Previous</span>
              {previous.data.label}
            </a>
          )
        }
        {
          next && (
            <a class={`${pagerLink} text-right max-[560px]:text-left`} href={`${base}/${next.id}/`}>
              <span class={pagerLabel}>Next</span>
              {next.data.label}
            </a>
          )
        }
      </nav>
    </main>
  </div>
  <script>
    import { setupReadingRail } from '../scripts/readingRail.ts';
    import { setupTargetedStatBlock } from '../scripts/targetedStatBlock.ts';

    setupReadingRail({
      linkSelector: '.book-headings a',
      scrollContainerSelector: '.book-sidebar',
      closeToggleSelector: '#book-nav-state',
    });
    setupTargetedStatBlock();
  </script>
</Layout>
